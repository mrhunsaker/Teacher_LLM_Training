# Local-only Pandoc configuration. Copy this file to .env and edit values.
# PANDOC_DATA_DIR must point to the directory containing the templates/ folder.
# Example on macOS/Linux: /Users/your-user/.local/share/pandoc
# Example on Windows: C:/Users/your-user/AppData/Roaming/pandoc
PANDOC_DATA_DIR=
PANDOC_TEMPLATE=eisvogel
PDF_ENGINE=xelatex
